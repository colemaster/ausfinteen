import FinancialDisclaimer from "@/components/astro/FinancialDisclaimer.astro";
import { TeenBudgeting } from "@/views/TeenBudgeting";
---

<Layout
  title="Teen Budgeting & First Paycheck Allocation (Module 3) | AusFinance Suite"
  description="Interactive paycheck splitter: Barefoot 3-bucket system (Blow, Mojo, Grow), inverted 50/30/20 rule for teens living at home, and automated payday routines."
