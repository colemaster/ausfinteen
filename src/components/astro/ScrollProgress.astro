---
interface Props {
  height?: string;
  gradient?: string;
}

const {
  height = 'h-[3.5px]',
  gradient = 'from-primary via-violet-500 to-amber-400',
} = Astro.props;
---

<!-- Quiet rail so the page has a finished top edge even before scrolling. -->
<div
  class="fixed top-0 left-0 right-0 z-[59] h-[3.5px] bg-border/20 pointer-events-none"
  aria-hidden="true"
></div>

<div
  id="scroll-progress-bar"
  class={`fixed top-0 left-0 z-[60] ${height} bg-gradient-to-r ${gradient} bg-[length:200%_100%] animate-text-shimmer rounded-r-full pointer-events-none shadow-[0_0_16px_oklch(var(--accent-l)_var(--accent-c)_var(--accent-h)/0.7)]`}
  style="width: 0%"
  aria-hidden="true"
></div>

<style>
  #scroll-progress-bar {
    will-change: transform, width;
  }

  /* Comet head: a bright bead that rides the leading edge of the bar. */
  #scroll-progress-bar::after {
    content: '';
    position: absolute;
    right: -1px;
    top: 50%;
    width: 9px;
    height: 9px;
    transform: translateY(-50%);
    border-radius: 999px;
    background: var(--accent-pop);
    box-shadow:
      0 0 0 3px oklch(var(--accent-l) var(--accent-c) var(--accent-h) / 0.18),
      0 0 14px 2px oklch(var(--accent-l) var(--accent-c) var(--accent-h) / 0.8);
  }

  /* CSS scroll-driven animation (Chrome 115+, Edge 115+, Firefox 135+) */
  @supports (animation-timeline: scroll()) {
    #scroll-progress-bar {
      width: 100% !important;
      transform-origin: left;
      scale: 0 1;
      animation: scroll-progress linear;
      animation-timeline: scroll();
      transition: none;
    }
    @keyframes scroll-progress {
      to {
        scale: 1 1;
      }
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #scroll-progress-bar {
      display: none;
    }
  }
</style>

<script is:inline>
  (function() {
    /* Only use JS fallback when CSS scroll-driven animations aren't supported */
    if (CSS.supports && CSS.supports('animation-timeline', 'scroll()')) return;

    function initScrollProgress() {
      const bar = document.getElementById('scroll-progress-bar');
      if (!bar || window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      let ticking = false;
      function update() {
        const doc = document.documentElement;
        const scrollTop = window.scrollY || doc.scrollTop;
        const height = doc.scrollHeight - doc.clientHeight;
        bar.style.width = (height > 0 ? Math.min(1, scrollTop / height) * 100 : 0) + '%';
        ticking = false;
      }
      window.addEventListener('scroll', function() {
        if (!ticking) {
          ticking = true;
          requestAnimationFrame(update);
        }
      }, { passive: true });
      window.addEventListener('resize', update, { passive: true });
      update();
    }
    document.addEventListener('astro:page-load', initScrollProgress);
    initScrollProgress();
  })();
</script>
