{
  "name": "au-personal-finance-tools",
  "private": true,
  "version": "7.9.0",
  "description": "Free, open-source, privacy-first suite of Australian personal finance calculators",
  "homepage": "https://github.com/colemaster/ausfinteen",
  "type": "module",
  "engines": {
    "node": ">=24.22.1"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "typecheck": "tsc --noEmit",
    "perf": "node scripts/perf-report.mjs",
    "perf:baseline": "npm run build && node scripts/perf-report.mjs --baseline docs/perf-baseline.json",
    "perf:compare": "npm run build && node scripts/perf-report.mjs --baseline docs/perf-baseline.json --json",
    "build:analyze": "ANALYZE=1 astro build",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@astrojs/react": "^7.1.2",
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "astro": "^7.4.4",
    "canvas-confetti": "^1.9.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "fuse.js": "^7.5.0",
    "lucide-react": "^1.63.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-is": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "recharts": "^3.10.1",
    "sonner": "^2.0.8"
  },
  "overrides": {
    "@astrojs/react": {
      "oxc-transform-react": "$oxc-transform-react"
    }
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/canvas-confetti": "^1.9.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/ui": "^5.0.5",
    "jsdom": "^30.1.3",
    "oxc-transform-react": "^0.156.0",
    "rollup-plugin-visualizer": "^7.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
