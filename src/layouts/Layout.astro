---
import '@/fonts.css';
import '@/index.css';
import SEOHead from '@/components/astro/SEOHead.astro';
import SkipLink from '@/components/astro/SkipLink.astro';
import ScrollProgress from '@/components/astro/ScrollProgress.astro';
import GlobalKeyboardShortcuts from '@/components/astro/GlobalKeyboardShortcuts.astro';
import AuraBackground from '@/components/astro/AuraBackground.astro';
import Navbar from '@/components/astro/Navbar.astro';
import Footer from '@/components/astro/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  keywords?: string;
  ogType?: string;
  canonicalUrl?: string;
  class?: string;
}

const {
  class: className = '',
  ...seoProps
} = Astro.props;
---

<!doctype html>
<html lang="en-AU" class="scroll-smooth" dir="ltr">
  <head>
    <SEOHead {...seoProps} />
  </head>
  <body class="min-h-screen flex flex-col bg-background text-foreground transition-colors duration-300 selection:bg-primary/25 selection:text-primary antialiased relative overflow-x-hidden">
    <!-- Full-viewport ambient wash. Sits behind everything, so every route gets
         the same softly lit backdrop without each page re-declaring gradients. -->
    <div class="page-ambient" aria-hidden="true"></div>

    <!-- Subtle noise overlay for tactile finish -->
    <div class="noise-grain fixed inset-0 pointer-events-none z-[5] mix-blend-overlay opacity-[0.03] dark:opacity-[0.02]" aria-hidden="true"></div>
    
    <!-- Accessible Skip Link -->
    <SkipLink />

    <!-- Top Viewport Scroll Progress (CSS scroll-driven animation with JS fallback) -->
    <ScrollProgress />

    <!-- Navigation Bar: static markup + a small vanilla script (no React) -->
    <Navbar />

    <!-- Page Content Container with Ambient Chromatic Aura -->
    <div class={`relative flex-1 w-full max-w-7xl mx-auto px-4 sm:px-6 py-6 ${className}`}>
      <AuraBackground />
      <!-- Decorative animated mesh orbs for extra depth -->
      <div class="mesh-glow-lg hidden xl:block -top-[15%] -right-[10%] opacity-40" aria-hidden="true"></div>
      <div class="mesh-glow-md hidden lg:block top-[40%] -left-[12%] opacity-30" aria-hidden="true"></div>
      <main id="main-content" tabindex="-1" class="relative z-10 focus:outline-none" transition:animate="fade">
        <slot />
      </main>
    </div>

    <!-- Footer: static markup + a small vanilla script (no React) -->
    <Footer />

    <!-- Zero-runtime Global Keyboard Shortcuts with ClientRouter navigate -->
    <GlobalKeyboardShortcuts />
  </body>
</html>
