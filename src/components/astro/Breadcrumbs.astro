---
interface BreadcrumbItem {
  label: string;
  href?: string;
}

interface Props {
  items: BreadcrumbItem[];
  class?: string;
}

const { items, class: className = '' } = Astro.props;
---

<nav aria-label="Breadcrumb" class={`flex items-center text-xs text-muted-foreground mb-6 ${className}`}>
  <ol
    class="play-surface play-gloss sheen lift-card card-depth inline-flex items-center gap-1 flex-wrap rounded-2xl px-2 py-1.5 transition-all duration-300 hover:border-primary/40 hover:shadow-[0_0_22px_-4px_oklch(var(--accent-l)_var(--accent-c)_var(--accent-h)/0.35)]"
    itemscope
    itemtype="https://schema.org/BreadcrumbList"
  >
    <li class="inline-flex items-center" itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
      <a
        href="/"
        class="group relative flex items-center gap-1.5 rounded-xl px-1.5 py-1 font-medium transition-colors hover:text-primary"
        itemprop="item"
        data-astro-prefetch="hover"
      >
        <span
          class="grid h-6 w-6 place-items-center rounded-lg bg-gradient-to-br from-primary via-primary to-violet-500 text-white shadow-[0_2px_0_0_oklch(var(--accent-l)_var(--accent-c)_var(--accent-h)/0.4),0_5px_10px_-4px_oklch(var(--accent-l)_var(--accent-c)_var(--accent-h)/0.6)] transition-transform duration-300 group-hover:-rotate-6 group-hover:scale-105"
          aria-hidden="true"
        >
          <svg
            class="h-3.5 w-3.5"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z" />
            <polyline points="9 22 9 12 15 12 15 22" />
          </svg>
        </span>
        <span itemprop="name" class="sr-only sm:not-sr-only sm:pl-0.5">Home</span>
      </a>
      <meta itemprop="position" content="1" />
    </li>

    {items.map((item, index) => (
      <li
        class="group/item inline-flex items-center gap-1.5"
        itemprop="itemListElement"
        itemscope
        itemtype="https://schema.org/ListItem"
      >
        <svg
          class="h-3 w-3 shrink-0 text-muted-foreground/40 transition-transform duration-300 group-hover/item:translate-x-0.5 group-hover/item:text-primary/70"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <polyline points="9 18 15 12 9 6" />
        </svg>
        {item.href ? (
          <a
            href={item.href}
            class="rounded-lg px-1.5 py-1 font-medium transition-colors hover:bg-primary/10 hover:text-primary"
            itemprop="item"
            data-astro-prefetch="hover"
          >
            <span itemprop="name">{item.label}</span>
          </a>
        ) : (
          <span
            class="relative inline-flex items-center gap-1.5 rounded-lg bg-primary/10 px-2 py-1 font-semibold text-foreground ring-1 ring-primary/20"
            aria-current="page"
            itemprop="name"
          >
            <span
              class="h-1.5 w-1.5 shrink-0 rounded-full bg-primary shadow-[0_0_6px_oklch(var(--accent-l)_var(--accent-c)_var(--accent-h)/0.9)] sparkle-dot"
              aria-hidden="true"
            ></span>
            <span class="truncate max-w-[200px] sm:max-w-none">{item.label}</span>
          </span>
        )}
        <meta itemprop="position" content={String(index + 2)} />
      </li>
    ))}
  </ol>
</nav>
