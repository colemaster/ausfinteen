---
import '@/fonts.css';
import '@fontsource/jetbrains-mono/latin-400.css';
import '@fontsource/jetbrains-mono/latin-500.css';
import '@fontsource/jetbrains-mono/latin-600.css';
import '@/index.css';
import SEOHead from '@/components/astro/SEOHead.astro';
import SkipLink from '@/components/astro/SkipLink.astro';
import ScrollProgress from '@/components/astro/ScrollProgress.astro';
import GlobalKeyboardShortcuts from '@/components/astro/GlobalKeyboardShortcuts.astro';
import AuraBackground from '@/components/astro/AuraBackground.astro';
import { Navbar } from '@/components/layout/Navbar';
import { Footer } from '@/components/layout/Footer';
import { Toaster } from '@/components/ui/Toaster';

interface Props {
  title?: string;
  description?: string;
  keywords?: string;
  ogType?: string;
  canonicalUrl?: string;
  class?: string;
}

const {
  class: className = '',
  ...seoProps
} = Astro.props;
---

<!doctype html>
<html lang="en-AU" class="scroll-smooth">
  <head>
    <SEOHead {...seoProps} />
  </head>
  <body class="min-h-screen flex flex-col bg-background text-foreground transition-colors duration-200 selection:bg-primary/20 selection:text-primary antialiased">
    <!-- Accessible Skip Link -->
    <SkipLink />

    <!-- Top Viewport Scroll Progress -->
    <ScrollProgress />

    <!-- Navigation Bar Island with ClientRouter persistence -->
    <Navbar client:load transition:persist />

    <!-- Page Content Container with Ambient Chromatic Aura -->
    <div class={`relative flex-1 w-full max-w-7xl mx-auto px-4 sm:px-6 py-6 ${className}`}>
      <AuraBackground />
      <main id="main-content" tabindex="-1" class="relative z-10 focus:outline-none" transition:animate="fade">
        <slot />
      </main>
    </div>

    <!-- Footer with viewport-visible lazy hydration -->
    <Footer client:visible />

    <!-- Toast Notifications with transition persistence -->
    <Toaster client:idle transition:persist />

    <!-- Zero-runtime Global Keyboard Shortcuts with ClientRouter navigate -->
    <GlobalKeyboardShortcuts />
  </body>
</html>
