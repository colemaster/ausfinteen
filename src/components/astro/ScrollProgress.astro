---
interface Props {
  height?: string;
  gradient?: string;
}

const {
  height = 'h-[3px]',
  gradient = 'from-primary via-violet-500 to-amber-400',
} = Astro.props;
---

<div
  id="scroll-progress-bar"
  class={`fixed top-0 left-0 z-50 ${height} bg-gradient-to-r ${gradient} pointer-events-none`}
  style="width: 0%"
  aria-hidden="true"
></div>

<style>
  /* CSS scroll-driven animation (Chrome 115+, Edge 115+, Firefox 135+) */
  @supports (animation-timeline: scroll()) {
    #scroll-progress-bar {
      width: 100% !important;
      transform-origin: left;
      scale: 0 1;
      animation: scroll-progress linear;
      animation-timeline: scroll();
      transition: none;
    }
    @keyframes scroll-progress {
      to {
        scale: 1 1;
      }
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #scroll-progress-bar {
      display: none;
    }
  }
</style>

<script is:inline>
  (function() {
    /* Only use JS fallback when CSS scroll-driven animations aren't supported */
    if (CSS.supports && CSS.supports('animation-timeline', 'scroll()')) return;

    function initScrollProgress() {
      const bar = document.getElementById('scroll-progress-bar');
      if (!bar || window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      let ticking = false;
      function update() {
        const doc = document.documentElement;
        const scrollTop = window.scrollY || doc.scrollTop;
        const height = doc.scrollHeight - doc.clientHeight;
        bar.style.width = (height > 0 ? Math.min(1, scrollTop / height) * 100 : 0) + '%';
        ticking = false;
      }
      window.addEventListener('scroll', function() {
        if (!ticking) {
          ticking = true;
          requestAnimationFrame(update);
        }
      }, { passive: true });
      window.addEventListener('resize', update, { passive: true });
      update();
    }
    document.addEventListener('astro:page-load', initScrollProgress);
    initScrollProgress();
  })();
</script>
