---
import Layout from "@/layouts/Layout.astro";
import Breadcrumbs from "@/components/astro/Breadcrumbs.astro";
import FinancialDisclaimer from "@/components/astro/FinancialDisclaimer.astro";
import { SuperDrawdown } from "@/views/SuperDrawdown";
---

<Layout
  title="Super Drawdown & Account-Based Pension Retirement Simulator | AusFinance Suite"
  description="Model your Australian Superannuation phase-down, statutory minimum pension drawdowns under Schedule 7 SISR, and 100% tax-free investment earnings."
  keywords="super drawdown calculator, account based pension, minimum pension drawdown Schedule 7, Australian retirement longevity"
>
  <Breadcrumbs items={[{ label: "Calculators", href: "/calculators" }, { label: "Super Drawdown Simulator" }]} />
  <SuperDrawdown client:load />
  <FinancialDisclaimer sourceYear="2026-27" />
</Layout>
