---
import Icon from '@/components/astro/Icon.astro';

const APP_VERSION = '7.2.0';
const GITHUB_URL = 'https://github.com/colemaster/ausfinteen';
const LAST_UPDATED = 'Sep 2026';

const TOOLS_LINKS = [
  { to: '/', label: 'Home' },
  { to: '/calculators', label: 'All Calculators' },
  { to: '/profile', label: 'My Profile' },
];
---

<footer class="relative bg-background border-t border-border/70 mt-auto transition-colors duration-300">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 py-8">
    <div class="grid grid-cols-1 md:grid-cols-[1fr_auto_auto] gap-6 text-sm text-muted-foreground">
      <div class="max-w-xl leading-relaxed">
        <strong class="text-foreground font-semibold">Not financial advice.</strong>
        AusTeen Money is a free educational tool made for young Aussies. All calculations are
        illustrative only and should not be relied upon for financial decisions. Always consult a
        licensed Australian financial adviser (AFS licence holder) before acting.
      </div>

      <nav aria-label="Tools" class="flex flex-col gap-1.5 text-xs">
        <span class="text-[10px] font-bold uppercase tracking-wider text-foreground">Tools</span>
        {TOOLS_LINKS.map(link => (
          <a
            href={link.to}
            data-astro-prefetch="hover"
            class="text-muted-foreground hover:text-foreground transition-colors"
          >
            {link.label}
          </a>
        ))}
      </nav>

      <div class="flex flex-col items-start md:items-end gap-2 text-xs">
        <div class="flex items-center gap-3">
          <span>© {new Date().getFullYear()} · MIT Licence</span>
          <span
            data-web-vitals-badge
            class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 font-mono font-bold border border-emerald-500/30 text-[11px]"
            title="Client-Side Telemetry: 100% Privacy-Preserved"
          >
            <Icon name="zap" class="w-3 h-3" />
            <span data-web-vitals-text>CLS 0.00 • TTFB <10ms</span>
          </span>
          <button
            type="button"
            data-open-performance
            class="inline-flex items-center gap-1 font-semibold text-emerald-600 dark:text-emerald-400 hover:underline"
          >
            <Icon name="zap" class="w-3 h-3" />
            <span>⚡ 100% Instant Mode</span>
          </button>
        </div>
        <a
          href={GITHUB_URL}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 text-muted-foreground hover:text-foreground transition-colors"
        >
          <svg
            viewBox="0 0 24 24"
            fill="currentColor"
            class="w-3.5 h-3.5"
            aria-hidden="true"
          >
            <path
              d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.11.79-.25.79-.56 0-.27-.01-1.14-.02-2.07-3.2.7-3.88-1.36-3.88-1.36-.52-1.33-1.28-1.68-1.28-1.68-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.18 1.76 1.18 1.02 1.75 2.69 1.25 3.34.95.1-.74.4-1.25.73-1.54-2.55-.29-5.23-1.28-5.23-5.68 0-1.26.45-2.28 1.18-3.09-.12-.29-.51-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11.03 11.03 0 0 1 5.77 0c2.2-1.49 3.17-1.18 3.17-1.18.62 1.59.23 2.76.11 3.05.73.81 1.18 1.83 1.18 3.09 0 4.41-2.69 5.38-5.25 5.67.41.35.78 1.05.78 2.12 0 1.53-.01 2.76-.01 3.14 0 .31.2.68.79.56A10.52 10.52 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5z"
            ></path>
          </svg>
          <span>View source on GitHub</span>
        </a>
        <span class="text-[11px] text-muted-foreground/80">
          v{APP_VERSION} · Last updated: {LAST_UPDATED}
        </span>
      </div>
    </div>

    <div
      class="mt-6 pt-4 border-t border-border/60 flex items-center justify-center gap-3 text-[11px] text-muted-foreground/80"
    >
      <span class="h-px w-10 bg-border" aria-hidden="true"></span>
      <span>Made for young Aussies</span>
      <span class="h-px w-10 bg-border" aria-hidden="true"></span>
    </div>
  </div>
</footer>

<script>
  import { initWebVitals, getPerformanceMetrics } from '@/lib/web-vitals';

  /* Astro's ClientRouter replaces the footer on every navigation, and this module can be
     evaluated more than once, so the polling interval and the document listener are bound
     once and always resolve the footer that is currently in the document. */
  const liveBadge = (): HTMLElement | null => document.querySelector<HTMLElement>('[data-web-vitals-text]');

  const paintBadge = () => {
    const badge = liveBadge();
    if (!badge) return;
    const metrics = getPerformanceMetrics();
    const cls = metrics.cls < 0.1 ? 'Good (0.00)' : metrics.cls.toFixed(3);
    const ttfb = metrics.ttfb !== null ? `${metrics.ttfb}ms` : '<10ms';
    badge.textContent = `CLS ${cls} • TTFB ${ttfb}`;
  };

  initWebVitals();
  paintBadge();

  const wired = window as unknown as Record<string, number | undefined>;
  if (wired.__ausFooterTimer === undefined) {
    wired.__ausFooterTimer = window.setInterval(paintBadge, 2000);
  }

  // The modal is the only consumer of the overlay host, and it should not be reachable from
  // the page's static module graph — so the loader is pulled in on click.
  document.addEventListener('click', (e) => {
    if (!(e.target as HTMLElement).closest('[data-open-performance]')) return;
    void import('@/lib/overlay-loader').then((m) => m.openPerformanceModal());
  });

  document.addEventListener('astro:page-load', paintBadge);
</script>
