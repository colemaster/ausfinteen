---
import Layout from "@/layouts/Layout.astro";
import Breadcrumbs from "@/components/astro/Breadcrumbs.astro";
import FinancialDisclaimer from "@/components/astro/FinancialDisclaimer.astro";
import { CGTEngine } from "@/views/CGTEngine";
---

<Layout
  title="Capital Gains Tax (CGT) Calculator & Multi-Asset Engine | AusFinance Suite"
  description="Multi-asset Australian Capital Gains Tax calculator: 50% CGT general discount, cost base indexation, capital loss carry-forward, and FY2026-27 marginal tax brackets."
  keywords="CGT calculator Australia, capital gains tax, 50% CGT discount, cost base calculator, capital losses carry forward, shares crypto property CGT"
>
  <Breadcrumbs items={[{ label: "Calculators", href: "/calculators" }, { label: "CGT Engine" }]} />
  <CGTEngine client:load />
  <FinancialDisclaimer sourceYear="2026-27" />
</Layout>
