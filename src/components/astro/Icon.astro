---
import { ICONS } from './icon-data';

interface Props {
  name: keyof typeof ICONS | string;
  class?: string;
  size?: number | string;
  strokeWidth?: number;
  'aria-hidden'?: boolean | 'true' | 'false';
}

const { name, class: className = '', size = 24, strokeWidth = 2, ...rest } = Astro.props;
const node = ICONS[name] ?? [];
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width={strokeWidth}
  stroke-linecap="round"
  stroke-linejoin="round"
  class={className}
  aria-hidden={rest['aria-hidden'] ?? 'true'}
  set:html={node.map(([tag, attrs]) => {
    const pairs = Object.entries(attrs)
      .map(([k, v]) => `${k}="${String(v)}"`)
      .join(' ');
    return `<${tag} ${pairs} />`;
  }).join('')}
></svg>
