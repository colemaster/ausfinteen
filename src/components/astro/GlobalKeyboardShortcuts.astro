<script>
  import { navigate } from 'astro:transitions/client';

  /* Loaded on demand: the shortcuts modal and command palette are the only consumers, and
     importing them statically would put the overlay loader on every page's critical path. */
  const loadOverlay = () => import('@/lib/overlay-loader');
  const motion = () => import('@/lib/motion-core');

  let gPressedAt = 0;

  function isTypingTarget(t: EventTarget | null): boolean {
    if (!t || !(t instanceof HTMLElement)) return false;
    return (
      t.tagName === 'INPUT' ||
      t.tagName === 'TEXTAREA' ||
      t.tagName === 'SELECT' ||
      t.isContentEditable
    );
  }

  function handleKeyDown(e: KeyboardEvent) {
    if (e.key === 'Escape') {
      // The overlays own their own Escape handling once mounted; these events are
      // harmless no-ops before then, which is what lets them load on demand.
      document.dispatchEvent(new CustomEvent('close-command-palette'));
      document.dispatchEvent(new CustomEvent('close-shortcuts-modal'));
      return;
    }
    if (isTypingTarget(e.target)) return;

    if (e.key === '?' || (e.shiftKey && e.key === '/')) {
      e.preventDefault();
      // Previously this was a bare event dispatch and the modal was always mounted.
      // Now it lazily fetches React the first time the shortcut is used. Once the host is
      // mounted the overlay toggles itself, so re-dispatch instead of re-mounting.
      void loadOverlay().then((m) => {
        if (m.isOverlayHostMounted()) document.dispatchEvent(new CustomEvent('toggle-shortcuts-modal'));
        else void m.toggleShortcutsModal();
      });
      return;
    }

    if (e.key === '/') {
      e.preventDefault();
      const input = document.getElementById('site-search-input') as HTMLInputElement | null;
      if (input && typeof input.focus === 'function') {
        input.focus();
        input.select();
      }
      return;
    }

    if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
      // The palette toggles itself from its own listener once mounted, so only preload
      // and open while it is absent.
      void loadOverlay().then((m) => {
        if (m.isOverlayHostMounted()) return;
        e.preventDefault();
        void m.openCommandPalette();
      });
      return;
    }

    const key = e.key.toLowerCase();
    if (key === 'g') {
      gPressedAt = Date.now();
      return;
    }

    if (gPressedAt > 0 && Date.now() - gPressedAt <= 1200) {
      gPressedAt = 0;
      if (key === 'h') {
        navigate('/');
      } else if (key === 'p') {
        navigate('/profile');
      } else if (key === 'c') {
        navigate('/calculators');
      } else if (key === 't') {
        navigate('/teen-budgeting');
      } else if (key === 'x') {
        navigate('/tax-guide');
      } else if (key === 's') {
        navigate('/super-retirement');
      } else if (key === 'b') {
        navigate('/brisbane-qld');
      }
    }
  }

  /* This component is re-evaluated by Astro's ClientRouter on every navigation, so the
     keydown listener is bound exactly once. Without the guard each navigation would leave
     another live listener behind and a single keypress would fire N handlers. */
  const wired = window as unknown as Record<string, boolean | undefined>;
  if (!wired.__ausShortcutsWired) {
    wired.__ausShortcutsWired = true;

    /* Resolve the OS-vs-override motion preference once and keep it in sync. Without
     * this the `data-motion` attribute is never written, so the CSS motion overrides
     * never activate for anyone who has not opened the appearance panel. */
    void motion().then((m) => m.initMotionPreference());

    document.addEventListener('keydown', handleKeyDown);

    /* --- Focus management across client-side navigation ---
     * Astro's ClientRouter announces the new page through a live region but does not
     * MOVE focus, so after a soft navigation focus is left on a detached element and the
     * next Tab restarts from the top of the document. Moving focus to the new page's
     * heading is the standard remedy.
     *
     * Skipped on first load: the browser has already placed focus sensibly, and stealing
     * it would yank it away from someone who has only just tabbed to the address bar. */
    let navigated = false;
    document.addEventListener('astro:page-load', () => {
      if (!navigated) {
        navigated = true;
        return;
      }
      const heading = document.querySelector<HTMLElement>('main h1') ?? document.querySelector<HTMLElement>('main');
      heading?.focus();
    });

    /* In-page `#anchor` links do not trigger a ClientRouter navigation, so the router
     * never runs and focus never lands on the target. Handle them explicitly. */
    document.addEventListener('click', (e) => {
      const link = (e.target as HTMLElement).closest<HTMLAnchorElement>('a[href^="#"]');
      if (!link) return;
      const hash = link.getAttribute('href');
      if (!hash || hash === '#') return;
      const target = document.querySelector<HTMLElement>(hash);
      if (!target) return;
      e.preventDefault();
      if (!target.hasAttribute('tabindex')) target.setAttribute('tabindex', '-1');
      target.focus();
      // `auto` rather than `smooth`: a smooth scroll on every nav is a vestibular trigger.
      target.scrollIntoView({ behavior: 'auto', block: 'start' });
      history.pushState(null, '', hash);
    });
  }
</script>
