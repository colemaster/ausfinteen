---
interface Props {
  badge?: string;
  title: string;
  description?: string;
  backHref?: string;
  backLabel?: string;
  moduleNumber?: number;
  class?: string;
}

const {
  badge,
  title,
  description,
  backHref,
  backLabel,
  moduleNumber,
  class: className = '',
} = Astro.props;
---

<header class={`relative mb-8 ${className}`}>
  {/* Decorative ink blot breathing behind the title block */}
  <div
    aria-hidden="true"
    class="pointer-events-none absolute -top-16 -left-10 w-64 h-64 ink-blot ink-blot-sm ink-blot-cyan dark:opacity-40"
  ></div>

  <div class="relative z-10 stagger-fade">
    {backHref && (
      <a
        href={backHref}
        data-astro-prefetch="hover"
        class="glass-panel inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold text-muted-foreground hover:text-primary transition-colors mb-4 group"
      >
        <span class="group-hover:-translate-x-1 transition-transform">←</span>
        <span>{backLabel || 'Back'}</span>
      </a>
    )}

    <div class="flex flex-wrap items-center gap-2.5 mb-2.5">
      {moduleNumber !== undefined && (
        <span class="relative inline-flex items-center isolate">
          {/* Rotating conic-gradient halo around the module pill */}
          <span class="gradient-border rounded-full absolute inset-0" aria-hidden="true"></span>
          <span class="relative z-10 isolate inline-flex items-center px-2.5 py-0.5 rounded-full text-[11px] font-bold tracking-wider uppercase bg-primary/10 text-primary border border-primary/25 font-mono shadow-xs card-specular">
            Module {moduleNumber}
          </span>
        </span>
      )}
      {badge && (
        <span class="card-specular inline-flex items-center px-2.5 py-0.5 rounded-full text-[11px] font-semibold bg-muted text-muted-foreground border border-border/60 shadow-xs">
          {badge}
        </span>
      )}
    </div>

    <h1
      class="text-2xl sm:text-3xl lg:text-4xl font-extrabold tracking-tight leading-tight text-transparent bg-gradient-to-r from-foreground via-foreground to-primary bg-clip-text"
      transition:name={`page-title-${title.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`}
    >
      {title}
    </h1>

    {/* Animated gradient accent bar that draws itself in under the title,
        tipped with a gently twinkling light */}
    <div class="relative mt-2.5 h-2 w-28" aria-hidden="true">
      <div class="absolute inset-x-0 top-1/2 mt-[-1.75px] h-[3.5px] rounded-full bg-muted"></div>
      <div
        class="absolute left-0 top-1/2 mt-[-1.75px] h-[3.5px] w-full rounded-full bg-gradient-to-r from-primary via-violet-400 to-amber-400 bar-fill shadow-[0_0_10px_oklch(var(--accent-l)_var(--accent-c)_var(--accent-h)/0.55)]"
      ></div>
      <span class="svg-dot absolute right-0 top-1/2 mt-[-3px] h-1.5 w-1.5 rounded-full bg-amber-400 shadow-[0_0_6px_rgba(251,191,36,0.9)]"></span>
    </div>

    {description && (
      <p class="mt-3 text-sm sm:text-base text-muted-foreground max-w-3xl leading-relaxed">
        {description}
      </p>
    )}
  </div>
</header>
