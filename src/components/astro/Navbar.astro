---
import Icon from '@/components/astro/Icon.astro';
import { NAV_MODULES } from '@/data/nav-modules';

const CALCS = [
  { route: '/hecs-payoff', emoji: '🎓', title: 'HECS-HELP vs Investing' },
  { route: '/super-drawdown', emoji: '⭐️', title: 'Super Drawdown & Pension' },
  { route: '/ev-novated-lease', emoji: '⚡️', title: 'EV Novated Lease vs Loan' },
  { route: '/cgt-engine', emoji: '🏡', title: 'CGT & 6-Year Exemption' },
  { route: '/financial-stress-test', emoji: '🛡️', title: 'Emergency Runway & Stress' },
];

const ACCENTS = [
  { value: 'emerald', label: 'Emerald', swatch: '#059669' },
  { value: 'violet', label: 'Violet', swatch: '#8b5cf6' },
  { value: 'amber', label: 'Amber', swatch: '#f59e0b' },
  { value: 'rose', label: 'Rose', swatch: '#e11d48' },
  { value: 'cyan', label: 'Cyan', swatch: '#0891b2' },
  { value: 'default', label: 'Default', swatch: 'oklch(0.6 0.1 250)' },
];

const MOTION_OPTIONS = [
  { value: 'system', label: 'Auto', title: 'Follow my device setting' },
  { value: 'full', label: 'Full', title: 'Always animate, even if my device asks to reduce motion' },
  { value: 'reduce', label: 'Calm', title: 'Minimise animation' },
];

const ACTIVE_INDICATOR =
  'text-primary font-bold bg-primary/10 shadow-[inset_0_1px_0_rgba(255,255,255,0.45),0_6px_16px_-8px_oklch(var(--accent-l)_var(--accent-c)_var(--accent-h)/0.55)] ring-1 ring-primary/25 after:absolute after:inset-x-3 after:bottom-1 after:h-[2.5px] after:rounded-full after:bg-gradient-to-r after:from-primary after:via-violet-400 after:to-emerald-400 after:shadow-[0_0_8px_rgba(16,185,129,0.5)] after:content-[""]';

const navLinkClasses = (active: boolean): string =>
  `nav-link group relative flex items-center gap-1.5 px-3 py-2 rounded-xl text-xs font-semibold transition-all duration-200 ${
    active
      ? ACTIVE_INDICATOR
      : 'text-muted-foreground hover:text-foreground hover:bg-muted/60 hover:-translate-y-0.5'
  }`;

const dropdownItemClasses = (active: boolean): string =>
  `nav-link group relative flex items-center gap-2 px-2.5 py-2 rounded-xl text-xs transition-all ${
    active ? ACTIVE_INDICATOR : 'text-foreground hover:bg-muted hover:translate-x-0.5'
  }`;

const CALC_ROUTES = [
  '/calculators',
  '/hecs-payoff',
  '/super-drawdown',
  '/ev-novated-lease',
  '/cgt-engine',
  '/financial-stress-test',
];

// Server-rendered path so the first paint already shows the correct active item,
// with no flash of an unstyled/inactive link before JS runs.
const path = Astro.url.pathname.replace(/\/index\.html$/, '/') || '/';
const isCalcsActive = CALC_ROUTES.includes(path);
const isModulesActive = path !== '/' && path !== '/profile' && !path.startsWith('/calculators');
---

<header class="sticky top-0 z-40 w-full backdrop-blur-xl bg-background/75 border-b border-border/60 glass-nav shadow-[0_1px_3px_rgba(0,0,0,0.02)] dark:shadow-[0_1px_3px_rgba(0,0,0,0.3)]" data-navbar>
  <div class="h-[3px] w-full bg-gradient-to-r from-primary via-violet-500 to-amber-500 bg-[length:200%_100%] animate-text-shimmer" aria-hidden="true"></div>

  {/* Soft chromatic wash behind the bar + a hairline of reflected light along
      the bottom edge. Both are paint-only and cost one gradient each. */}
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-x-0 top-0 h-24 bg-gradient-to-b from-primary/[0.07] via-violet-500/[0.03] to-transparent"
  ></div>
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-x-0 -bottom-px h-px bg-gradient-to-r from-transparent via-primary/50 to-transparent"
  ></div>

  {/* Decorative ink blot behind the brand mark */}
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-0 ink-blot ink-blot-md ink-blot-cyan dark:opacity-50"
  />

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16 relative z-10">
      <a
        href="/"
        data-sound="click"
        data-astro-prefetch="hover"
        class="flex shrink-0 items-center gap-2 sm:gap-2.5 group"
      >
        <div class="relative">
          {/* Living canvas glow behind the brand mark — brightens + lifts on hover */}
          <div
            aria-hidden="true"
            class="absolute -inset-1.5 rounded-2xl bg-gradient-to-tr from-amber-500 via-primary to-violet-500 blur-md opacity-40 group-hover:opacity-80 transition-opacity duration-300 pointer-events-none"
          ></div>
          {/* Playful orbit bead circling the coin mark */}
          <span
            aria-hidden="true"
            class="orbit-ring -inset-2 opacity-0 transition-opacity duration-300 group-hover:opacity-100 hidden sm:block"
          ></span>
          {/* The mark itself: a glossy 3D coin with a specular top edge */}
          <div class="relative z-10 grid h-10 w-10 place-items-center rounded-2xl border border-white/45 bg-gradient-to-br from-amber-300 via-primary to-violet-500 text-white shadow-[inset_0_1px_0_rgba(255,255,255,0.6),inset_0_-1px_0_rgba(0,0,0,0.18),0_5px_0_-1px_oklch(var(--accent-l)_var(--accent-c)_var(--accent-h)/0.35),0_12px_22px_-8px_oklch(var(--accent-l)_var(--accent-c)_var(--accent-h)/0.65)] transition-transform duration-300 group-hover:scale-105 group-hover:-rotate-6 group-active:scale-95 group-active:translate-y-0.5 sm:h-11 sm:w-11">
            <Icon name="sparkles" class="w-5 h-5 drop-shadow-[0_1px_1px_rgba(0,0,0,0.25)] group-hover:animate-pulse-soft" />
          </div>
          <span
            aria-hidden="true"
            class="absolute -right-0.5 -top-0.5 h-2 w-2 rounded-full bg-amber-300 shadow-[0_0_0_3px_rgba(251,191,36,0.18),0_0_10px_rgba(251,191,36,0.95)] animate-twinkle"
          ></span>
        </div>
        <div>
          <span class="block whitespace-nowrap font-extrabold text-[15px] sm:text-lg text-foreground tracking-tight leading-tight">
            AusFinance <span class="text-transparent bg-gradient-to-r from-primary via-primary to-violet-600 bg-clip-text dark:to-violet-300">Suite</span>
          </span>
          <span class="flex items-center gap-1 whitespace-nowrap text-[9px] font-semibold text-muted-foreground uppercase tracking-wide leading-tight sm:text-[10px] sm:tracking-wider">
            <span class="h-1.5 w-1.5 rounded-full bg-emerald-500 shadow-[0_0_6px_rgba(16,185,129,0.9)]" aria-hidden="true"></span>
            2026-27 Compliant ⚡️
          </span>
        </div>
      </a>

      <nav class="hidden xl:flex items-center gap-1.5 text-xs font-semibold" aria-label="Primary">
        <div class="relative" data-dropdown="calcs">
          <button
            type="button"
            data-dropdown-toggle="calcs"
            data-sound="click"
            aria-expanded="false"
            aria-controls="nav-calculators-panel"
            class={navLinkClasses(isCalcsActive)}
          >
            <Icon name="calculator" class="w-3.5 h-3.5 text-primary" />
            <span><span aria-hidden="true">⚡️</span> 2026 Calculators</span>
            <Icon name="chevron-down" class="w-3 h-3 transition-transform" data-chevron />
          </button>

          {/*
            Disclosure navigation, NOT a menu.

            The previous markup used `role="menu"` + `role="menuitem"`, which is a hard
            contract: assistive tech announces "menu, 11 items" and then expects
            arrow-key roving tabindex, Home/End and Escape. None of that was
            implemented, so the widget announced itself as a menu and then behaved
            like a plain disclosure — a WCAG 4.1.2 / 2.1.1 failure. Site navigation is
            exactly the case the APG says does *not* need the menu pattern, so the
            roles are removed and the button carries `aria-expanded` + `aria-controls`.
          */}
          <div
            id="nav-calculators-panel"
            data-dropdown-panel="calcs"
            hidden
            class="play-surface play-gloss absolute top-full left-0 mt-3 w-80 p-2 rounded-2xl shadow-2xl ring-1 ring-black/5 dark:ring-white/5 grid grid-cols-1 gap-0.5 z-50 animate-slide-down-in card-depth"
          >
            <div class="flex items-center justify-between px-2 pb-1.5 mb-1 border-b border-border/60">
              <span class="text-[10px] uppercase tracking-[0.18em] font-bold text-muted-foreground">Next-gen calculators</span>
              <span class="text-[9px] font-mono font-bold text-primary/80">{CALCS.length + 1} tools</span>
            </div>

            <a
              href="/calculators"
              data-astro-prefetch="hover"
              data-sound="click"
              data-close-dropdown
              class="p-2 rounded-xl bg-gradient-to-r from-primary/15 via-primary/10 to-violet-500/10 text-primary font-bold flex items-center justify-between text-xs mb-1 ring-1 ring-primary/20 shine-sweep"
            >
              <span><span aria-hidden="true">⚡️</span> Browse All Calculators</span>
              <span class="text-[10px] uppercase font-mono">Hub →</span>
            </a>

            {CALCS.map(c => (
              <a
                href={c.route}
                data-astro-prefetch="hover"
                data-sound="click"
                data-close-dropdown
                class={dropdownItemClasses(path === c.route)}
              >
                <span
                  class="grid h-7 w-7 shrink-0 place-items-center rounded-lg bg-gradient-to-br from-primary/15 to-violet-500/15 text-base ring-1 ring-border/60 transition-transform duration-200 group-hover:scale-110 group-hover:-rotate-3"
                  aria-hidden="true"
                >{c.emoji}</span>
                <span class="truncate">{c.title}</span>
                <span class="ml-auto text-primary opacity-0 transition-opacity group-hover:opacity-100" aria-hidden="true">→</span>
              </a>
            ))}

            <div class="mt-1 flex items-center justify-between rounded-lg bg-muted/50 px-2 py-1.5 text-[9px] text-muted-foreground">
              <span>Tip: press <kbd class="font-mono font-bold text-foreground">⌘K</kbd> from anywhere</span>
              <span class="font-mono text-primary/70">v7.5</span>
            </div>
          </div>
        </div>

        <div class="relative" data-dropdown="modules">
          <button
            type="button"
            data-dropdown-toggle="modules"
            data-sound="click"
            aria-expanded="false"
            aria-controls="nav-modules-panel"
            class={navLinkClasses(isModulesActive)}
          >
            <Icon name="book-open" class="w-3.5 h-3.5" />
            <span>11 Learning Modules</span>
            <Icon name="chevron-down" class="w-3 h-3 transition-transform" data-chevron />
          </button>

          <div
            id="nav-modules-panel"
            data-dropdown-panel="modules"
            hidden
            class="play-surface play-gloss absolute top-full left-0 mt-3 w-72 max-h-[70vh] overflow-y-auto p-2 rounded-2xl shadow-2xl ring-1 ring-black/5 dark:ring-white/5 grid grid-cols-1 gap-0.5 z-50 animate-slide-down-in card-depth"
          >
            <div class="sticky top-0 z-10 -mx-2 -mt-2 mb-1 flex items-center justify-between border-b border-border/60 bg-card/90 px-3.5 py-2 backdrop-blur-sm">
              <span class="text-[10px] uppercase tracking-[0.18em] font-bold text-muted-foreground">Learning modules</span>
              <span class="rounded-full bg-violet-500/15 px-1.5 py-0.5 text-[9px] font-mono font-bold text-violet-500">11</span>
            </div>
            {NAV_MODULES.map(m => (
              <a
                href={m.route}
                data-astro-prefetch="hover"
                data-sound="click"
                data-close-dropdown
                data-module-route={m.route}
                class={dropdownItemClasses(path === m.route)}
              >
                <span
                  class="grid h-7 w-7 shrink-0 place-items-center rounded-lg bg-gradient-to-br from-violet-500/15 to-primary/10 text-base ring-1 ring-border/60 transition-transform duration-200 group-hover:scale-110 group-hover:rotate-3"
                  aria-hidden="true"
                >{m.emoji}</span>
                <span class="truncate">{m.title}</span>
              </a>
            ))}
          </div>
        </div>

        <a
          href="/profile"
          data-astro-prefetch="hover"
          data-sound="click"
          data-nav-route="/profile"
          class={navLinkClasses(path === '/profile')}
        >
          <Icon name="user" class="w-3.5 h-3.5" />
          <span>Profile (<span data-profile-age>15</span>yo)</span>
        </a>

        <a
          href="/brisbane-qld"
          data-astro-prefetch="hover"
          data-sound="click"
          data-nav-route="/brisbane-qld"
          class={navLinkClasses(path === '/brisbane-qld')}
          title="Change your location in My Profile"
        >
          <Icon name="map-pin" class="w-3.5 h-3.5" />
          <span data-profile-location>Brisbane, QLD</span>
        </a>
      </nav>

      <div class="flex shrink-0 items-center gap-0.5 sm:gap-1.5">
        <a
          href="https://github.com/colemaster/ausfinteen/releases"
          target="_blank"
          rel="noreferrer"
          title="What's new in v7.5.0 — changelog"
          aria-label="What's new in v7.5.0 — changelog"
          class="play-surface sticker-badge shine-sweep hidden sm:inline-flex items-center gap-1.5 px-2.5 py-1.5 rounded-full text-muted-foreground hover:text-primary hover:border-primary/40 transition-all text-[10px] font-bold"
          style="--sticker-rotate: 1.5deg;"
        >
          <span class="relative flex h-2 w-2" aria-hidden="true">
            <span class="absolute inline-flex h-full w-full rounded-full bg-emerald-500 opacity-75 animate-ping motion-reduce:animate-none"></span>
            <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500 shadow-[0_0_6px_rgba(16,185,129,0.9)]"></span>
          </span>
          v7.5.0
        </a>

        <button
          type="button"
          data-open-palette
          data-sound="click"
          aria-label="Open command palette (Ctrl+K)"
          title="Command Center (Ctrl+K)"
          class="group flex items-center gap-1.5 rounded-xl border border-transparent px-1.5 py-1.5 text-muted-foreground transition-all hover:border-border hover:bg-card/80 hover:text-foreground hover:shadow-[0_4px_12px_-6px_oklch(var(--accent-l)_var(--accent-c)_var(--accent-h)/0.45)] sm:px-2.5"
        >
          <Icon name="search" class="w-4 h-4 transition-transform group-hover:scale-110 group-hover:-rotate-6" />
          <kbd class="hidden sm:inline font-mono text-[10px] font-bold px-1.5 py-0.5 rounded-md border border-border/80 bg-card shadow-[0_1px_0_rgba(255,255,255,0.4)_inset]">⌘K</kbd>
        </button>

        <button
          type="button"
          data-sound-toggle
          aria-label="Mute sound effects"
          title="Mute sound effects"
          class="group rounded-xl border border-transparent p-1.5 text-muted-foreground transition-all hover:border-border hover:bg-card/80 hover:text-foreground hover:shadow-[0_4px_12px_-6px_oklch(var(--accent-l)_var(--accent-c)_var(--accent-h)/0.45)] sm:p-2"
        >
          <Icon name="volume-2" class="w-4 h-4 text-primary transition-transform group-hover:scale-110" data-icon-sound-on />
          <Icon name="volume-x" class="w-4 h-4 opacity-60 hidden transition-transform group-hover:scale-110" data-icon-sound-off />
        </button>

        <button
          type="button"
          data-theme-toggle
          aria-label="Switch to Light Mode"
          title="Switch to Light Mode"
          class="group rounded-xl border border-transparent p-1.5 text-muted-foreground transition-all hover:border-border hover:bg-card/80 hover:text-foreground hover:shadow-[0_4px_12px_-6px_oklch(var(--accent-l)_var(--accent-c)_var(--accent-h)/0.45)] sm:p-2"
        >
          <Icon name="sun" class="w-4 h-4 text-amber-400 transition-transform duration-300 group-hover:rotate-45 group-hover:scale-110" data-icon-theme-dark />
          <Icon name="moon" class="w-4 h-4 text-slate-700 hidden transition-transform duration-300 group-hover:-rotate-12 group-hover:scale-110" data-icon-theme-light />
        </button>

        <div class="relative" data-dropdown="appearance">
          <button
            type="button"
            data-dropdown-toggle="appearance"
            data-sound="click"
            aria-label="Appearance settings (accent colour and font size)"
            aria-expanded="false"
            aria-controls="appearance-popover"
            title="Appearance"
            class="group rounded-xl border border-transparent p-1.5 text-muted-foreground transition-all hover:border-border hover:bg-card/80 hover:text-foreground hover:shadow-[0_4px_12px_-6px_oklch(var(--accent-l)_var(--accent-c)_var(--accent-h)/0.45)] sm:p-2"
          >
            <Icon name="palette" class="w-4 h-4 transition-transform duration-300 group-hover:rotate-12 group-hover:scale-110" />
          </button>
          <div
            id="appearance-popover"
            data-dropdown-panel="appearance"
            hidden
            class="play-surface play-gloss absolute right-0 top-full mt-3 z-50 w-64 rounded-2xl p-4 shadow-2xl ring-1 ring-black/5 dark:ring-white/5 space-y-4 animate-slide-down-in card-depth"
          >
            <div class="-mx-4 -mt-4 mb-3 flex items-center gap-2 border-b border-border/60 bg-gradient-to-r from-primary/10 via-violet-500/5 to-transparent px-4 py-2.5">
              <span class="grid h-6 w-6 place-items-center rounded-lg bg-gradient-to-br from-primary to-violet-500 text-white shadow-[0_3px_8px_-3px_oklch(var(--accent-l)_var(--accent-c)_var(--accent-h)/0.7)]">
                <Icon name="palette" class="w-3 h-3" />
              </span>
              <span class="text-[10px] font-bold uppercase tracking-[0.16em] text-foreground">Make it yours</span>
            </div>
            <div class="space-y-2">
              <p class="flex items-center gap-1.5 text-[11px] font-bold uppercase tracking-wider text-muted-foreground">
                <Icon name="palette" class="w-3 h-3" /> Accent colour
              </p>
              <div class="flex items-center gap-1.5" role="group" aria-label="Accent colour">
                {ACCENTS.map(a => (
                  <button
                    type="button"
                    title={a.label}
                    aria-label={a.label}
                    aria-pressed="false"
                    data-accent-value={a.value}
                    class="relative h-6 w-6 shrink-0 cursor-pointer rounded-full transition-transform duration-200 hover:scale-110 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 focus-visible:ring-offset-background shadow-[inset_0_2px_2px_rgba(255,255,255,0.55),inset_0_-2px_3px_rgba(0,0,0,0.22),0_2px_4px_rgba(0,0,0,0.18)] ring-1 ring-black/10"
                    style={`background-color: ${a.swatch}`}
                  ></button>
                ))}
              </div>
            </div>
            <div class="space-y-2">
              <p class="flex items-center gap-1.5 text-[11px] font-bold uppercase tracking-wider text-muted-foreground">
                <Icon name="check" class="w-3 h-3" /> Text size
              </p>
              <div class="flex items-center gap-1" role="group" aria-label="Font size">
                <button
                  type="button"
                  data-font-scale-down
                  aria-label="Decrease font size"
                  class="flex h-7 w-7 cursor-pointer items-center justify-center rounded-lg border border-border bg-card text-xs font-bold text-foreground shadow-[0_1px_0_rgba(255,255,255,0.4)_inset,0_2px_4px_-2px_rgba(0,0,0,0.12)] transition-all hover:-translate-y-0.5 hover:bg-muted disabled:cursor-not-allowed disabled:opacity-40"
                  >A−</button
                >
                <button
                  type="button"
                  data-font-scale-up
                  aria-label="Increase font size"
                  class="flex h-7 w-7 cursor-pointer items-center justify-center rounded-lg border border-border bg-card text-sm font-bold text-foreground shadow-[0_1px_0_rgba(255,255,255,0.4)_inset,0_2px_4px_-2px_rgba(0,0,0,0.12)] transition-all hover:-translate-y-0.5 hover:bg-muted disabled:cursor-not-allowed disabled:opacity-40"
                  >A+</button
                >
              </div>
            </div>
            <div class="space-y-2">
              <p class="flex items-center gap-1.5 text-[11px] font-bold uppercase tracking-wider text-muted-foreground">
                <Icon name="zap" class="w-3 h-3" /> Motion
              </p>
              {/*
                A radio group rather than a checkbox: a checkbox cannot express the
                third state, and "follow the system setting" has to be selectable or
                the control overrides the OS preference by default.
              */}
              <div
                class="flex items-center gap-1"
                role="radiogroup"
                aria-label="Motion preference"
                data-motion-group
              >
                {MOTION_OPTIONS.map(opt => (
                  <button
                    type="button"
                    role="radio"
                    aria-checked="false"
                    data-motion-value={opt.value}
                    title={opt.title}
                    class="flex-1 cursor-pointer rounded-lg border border-border bg-card/60 px-1.5 py-1 text-[10px] font-bold text-muted-foreground transition-all hover:bg-muted hover:text-foreground aria-checked:border-primary aria-checked:bg-primary/10 aria-checked:text-primary aria-checked:shadow-[0_0_0_1px_oklch(var(--accent-l)_var(--accent-c)_var(--accent-h)/0.35),0_4px_10px_-4px_oklch(var(--accent-l)_var(--accent-c)_var(--accent-h)/0.5)]"
                  >
                    {opt.label}
                  </button>
                ))}
              </div>
            </div>
            <p class="text-[10px] leading-relaxed text-muted-foreground/80">
              Choices are saved in the page URL — share the link to share your look.
            </p>
          </div>
        </div>

        <button
          type="button"
          data-mobile-toggle
          data-sound="click"
          aria-label="Open menu"
          aria-expanded="false"
          aria-controls="mobile-nav-drawer"
          class="group rounded-xl border border-transparent p-1.5 text-muted-foreground transition-all hover:border-border hover:bg-card/80 hover:text-foreground sm:p-2 xl:hidden"
        >
          <Icon name="menu" class="w-5 h-5 transition-transform group-hover:scale-110" data-icon-menu-open />
          <Icon name="x" class="w-5 h-5 hidden transition-transform group-hover:rotate-90" data-icon-menu-close />
        </button>
      </div>
    </div>
  </div>

  <div
    id="mobile-nav-drawer"
    data-mobile-drawer
    hidden
    class="xl:hidden border-t border-border bg-card/95 backdrop-blur-xl px-4 py-4 space-y-1.5 max-h-[80vh] overflow-y-auto glass-panel relative"
  >
    {/* Profile hero — doubles as the "my profile" link and gives the drawer a
        proper graphic header instead of starting with a list. */}
    <a
      href="/profile"
      data-astro-prefetch="hover"
      data-sound="click"
      data-close-mobile
      class="play-surface play-gloss relative mb-2 flex items-center gap-3 overflow-hidden rounded-2xl p-3 pr-2.5 card-depth group"
    >
      <span aria-hidden="true" class="conic-aurora -right-14 -top-16 h-40 w-40 opacity-40"></span>
      <span class="relative z-10 grid h-11 w-11 shrink-0 place-items-center rounded-2xl border border-white/40 bg-gradient-to-br from-primary via-primary to-violet-500 text-base font-black text-white shadow-[inset_0_1px_0_rgba(255,255,255,0.55),0_6px_14px_-6px_oklch(var(--accent-l)_var(--accent-c)_var(--accent-h)/0.8)]">
        <Icon name="user" class="h-5 w-5" />
      </span>
      <span class="relative z-10 min-w-0 flex-1">
        <span class="block text-[10px] font-bold uppercase tracking-[0.16em] text-muted-foreground">Welcome back</span>
        <span class="block truncate text-sm font-extrabold text-foreground">
          <span data-profile-name>Issy</span>, <span data-profile-age>15</span>yo
        </span>
        <span class="mt-0.5 flex items-center gap-1 text-[10px] font-semibold text-muted-foreground">
          <Icon name="map-pin" class="h-3 w-3 text-primary" />
          <span data-profile-location>Brisbane, QLD</span>
        </span>
      </span>
      <span class="relative z-10 grid h-7 w-7 shrink-0 place-items-center rounded-full bg-primary/10 text-primary ring-1 ring-primary/25 transition-transform group-hover:translate-x-0.5">
        →
      </span>
    </a>

    <a
      href="/calculators"
      data-astro-prefetch="hover"
      data-sound="click"
      data-close-mobile
      class="shine-sweep flex items-center gap-2.5 rounded-xl bg-gradient-to-r from-primary/15 via-primary/10 to-violet-500/10 p-2.5 text-xs font-bold text-primary ring-1 ring-primary/25 card-specular"
    >
      <span class="grid h-6 w-6 place-items-center rounded-lg bg-primary/15">
        <Icon name="calculator" class="w-4 h-4" />
      </span>
      <span>⚡️ 2026 Financial Calculators Suite</span>
      <span class="ml-auto font-mono text-[10px] uppercase">Hub →</span>
    </a>

    <div class="flex items-center gap-2 px-2 pt-2 text-[11px] font-bold uppercase tracking-wider text-muted-foreground">
      <span class="h-1.5 w-1.5 rounded-full bg-amber-400 shadow-[0_0_6px_rgba(251,191,36,0.9)]"></span>
      Next-Gen Calculators
    </div>
    {CALCS.map(c => (
      <a
        href={c.route}
        data-astro-prefetch="hover"
        data-sound="click"
        data-close-mobile
        class="group flex items-center gap-2.5 rounded-xl border border-transparent p-2 text-xs text-foreground transition-all duration-200 hover:border-border/70 hover:bg-muted hover:translate-x-1 hover:text-primary"
      >
        <span
          class="grid h-7 w-7 shrink-0 place-items-center rounded-lg bg-gradient-to-br from-primary/15 to-violet-500/15 text-base ring-1 ring-border/60 transition-transform duration-200 group-hover:scale-110 group-hover:-rotate-3"
          aria-hidden="true">{c.emoji}</span>
        <span>{c.title}</span>
        <span class="ml-auto text-primary opacity-0 transition-opacity group-hover:opacity-100" aria-hidden="true">→</span>
      </a>
    ))}

    <div class="flex items-center gap-2 px-2 pt-2 text-[11px] font-bold uppercase tracking-wider text-muted-foreground">
      <span class="h-1.5 w-1.5 rounded-full bg-violet-500 shadow-[0_0_6px_oklch(0.55_0.2_293/0.8)]"></span>
      11 Real-World Learning Modules
    </div>
    {NAV_MODULES.map(m => (
      <a
        href={m.route}
        data-astro-prefetch="hover"
        data-sound="click"
        data-close-mobile
        class="group flex items-center gap-2.5 rounded-xl border border-transparent p-2 text-xs text-foreground transition-all duration-200 hover:border-border/70 hover:bg-muted hover:translate-x-1 hover:text-primary"
      >
        <span
          class="grid h-7 w-7 shrink-0 place-items-center rounded-lg bg-gradient-to-br from-violet-500/15 to-primary/10 text-base ring-1 ring-border/60 transition-transform duration-200 group-hover:scale-110 group-hover:rotate-3"
          aria-hidden="true">{m.emoji}</span>
        <span>{m.title}</span>
      </a>
    ))}
  </div>
</header>

<script>
  import { getInitialAccent, getInitialFontScale, toggleTheme, setAccent, setFontScale, type Accent, type FontScale } from '@/lib/theme-core';

  const doc = document.documentElement;

  /* `overlay-loader` and `sound-synthesizer` are imported dynamically rather than statically.
     Both are pure interaction affordances — a command palette and UI click sounds — so keeping
     them out of the static graph stops them blocking the Navbar script on every page. */
  const loadOverlay = () => import('@/lib/overlay-loader');
  const motion = () => import('@/lib/motion-core');

  let soundMod: typeof import('@/lib/sound-synthesizer') | null = null;
  let soundPending: Promise<void> | null = null;
  const getSound = () => soundMod?.sound ?? null;
  /** Fetch the audio synth once, on the first interaction that actually needs it. */
  function ensureSound(): Promise<void> {
    soundPending ??= import('@/lib/sound-synthesizer').then((m) => {
      soundMod = m;
    });
    return soundPending;
  }

  const playClick = () => void ensureSound().then(() => getSound()?.playClick());

  type NavRoot = HTMLElement & {
    __closeAll?: (returnFocusTo?: HTMLElement) => void;
    __closeOutside?: (target: Node) => void;
    __applyTheme?: () => void;
    __paintProfile?: () => void;
    __focusFirstItem?: () => void;
  };

  const liveRoot = (): NavRoot | null => document.querySelector<NavRoot>('[data-navbar]');

  const ACTIVE_INDICATOR =
    'text-primary font-bold bg-primary/10 shadow-[inset_0_1px_0_rgba(255,255,255,0.45),0_6px_16px_-8px_oklch(var(--accent-l)_var(--accent-c)_var(--accent-h)/0.55)] ring-1 ring-primary/25 after:absolute after:inset-x-3 after:bottom-1 after:h-[2.5px] after:rounded-full after:bg-gradient-to-r after:from-primary after:via-violet-400 after:to-emerald-400 after:shadow-[0_0_8px_rgba(16,185,129,0.5)] after:content-[""]';
  const INACTIVE_INDICATOR = 'text-muted-foreground hover:text-foreground hover:bg-muted/60 hover:-translate-y-0.5';

  /** classList.toggle throws on space-separated names, so apply each token. */
  const toggleClasses = (el: Element, classes: string, on: boolean) => {
    for (const token of classes.split(/\s+/)) {
      if (token) el.classList.toggle(token, on);
    }
  };

  const CALC_ROUTES = [
    '/calculators',
    '/hecs-payoff',
    '/super-drawdown',
    '/ev-novated-lease',
    '/cgt-engine',
    '/financial-stress-test',
  ];

  /**
   * Wire up the header currently in the document.
   *
   * Astro's ClientRouter swaps the document without a reload, so this runs again on every
   * navigation and `root` is a brand new element each time. Guarded per element so a repeat
   * call on the same node is a no-op, and every listener is attached to elements inside
   * `root` (which is discarded on swap) rather than to `document` — see the once-bound
   * block at the bottom for the handful of listeners that genuinely need `document`.
   */
  function init(root: NavRoot) {
    if (root.dataset.navReady === '1') return;
    root.dataset.navReady = '1';

    /* ---------------------------------------------------------------- dropdowns */

    const dropdowns = new Map<string, { button: HTMLButtonElement; panel: HTMLElement }>();
    for (const button of root.querySelectorAll<HTMLButtonElement>('[data-dropdown-toggle]')) {
      const key = button.dataset.dropdownToggle!;
      const panel = root.querySelector<HTMLElement>(`[data-dropdown-panel="${key}"]`);
      if (panel) dropdowns.set(key, { button, panel });
    }

    const closeDropdown = (key: string) => {
      const entry = dropdowns.get(key);
      if (!entry) return;
      entry.panel.hidden = true;
      entry.button.setAttribute('aria-expanded', 'false');
      entry.button.querySelector('[data-chevron]')?.classList.remove('rotate-180');
    };

    const closeAllDropdowns = (except?: string) => {
      for (const key of dropdowns.keys()) if (key !== except) closeDropdown(key);
    };

    for (const [key, { button, panel }] of dropdowns) {
      button.addEventListener('click', () => {
        const willOpen = panel.hidden;
        closeAllDropdowns(key);
        panel.hidden = !willOpen;
        button.setAttribute('aria-expanded', String(willOpen));
        button.querySelector('[data-chevron]')?.classList.toggle('rotate-180', willOpen);
      });
    }

    for (const el of root.querySelectorAll('[data-close-dropdown]')) {
      el.addEventListener('click', () => closeAllDropdowns());
    }

    /* ------------------------------------------------------------- mobile drawer */

    const mobileButton = root.querySelector<HTMLButtonElement>('[data-mobile-toggle]');
    const mobileDrawer = root.querySelector<HTMLElement>('[data-mobile-drawer]');
    const iconMenuOpen = root.querySelector('[data-icon-menu-open]');
    const iconMenuClose = root.querySelector('[data-icon-menu-close]');

    const setMobileOpen = (open: boolean) => {
      if (!mobileButton || !mobileDrawer) return;
      mobileDrawer.hidden = !open;
      mobileButton.setAttribute('aria-expanded', String(open));
      mobileButton.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
      iconMenuOpen?.classList.toggle('hidden', open);
      iconMenuClose?.classList.toggle('hidden', !open);
    };

    mobileButton?.addEventListener('click', () => setMobileOpen(!!mobileDrawer?.hidden));
    for (const el of root.querySelectorAll('[data-close-mobile]')) {
      el.addEventListener('click', () => setMobileOpen(false));
    }

    // Handlers for the once-bound document listeners, resolved lazily so a stale header
    // swapped out by ClientRouter is never touched.
    root.__closeAll = (returnFocusTo?: HTMLElement) => {
      // Returning focus to the disclosure button is the documented expectation for the
      // APG disclosure pattern; without it keyboard users are dropped to <body>.
      const open = [...dropdowns.entries()].find(([, { panel }]) => !panel.hidden);
      if (returnFocusTo) returnFocusTo.focus();
      else if (open) open[1].button.focus();
      closeAllDropdowns();
      setMobileOpen(false);
    };
    root.__closeOutside = (target: Node) => {
      for (const [key, { button, panel }] of dropdowns) {
        if (panel.hidden) continue;
        if (!button.contains(target) && !panel.contains(target)) closeDropdown(key);
      }
    };
    root.__focusFirstItem = () => {
      for (const { button, panel } of dropdowns.values()) {
        if (panel.hidden) continue;
        panel.querySelector<HTMLElement>('a, button')?.focus();
        return;
      }
    };

    /* -------------------------------------------------------------- theme toggle */

    const themeButton = root.querySelector<HTMLButtonElement>('[data-theme-toggle]');
    const iconThemeDark = root.querySelector('[data-icon-theme-dark]');
    const iconThemeLight = root.querySelector('[data-icon-theme-light]');

    const paintThemeButton = () => {
      const dark = doc.classList.contains('dark');
      const label = `Switch to ${dark ? 'Light' : 'Dark'} Mode`;
      themeButton?.setAttribute('aria-label', label);
      themeButton?.setAttribute('title', label);
      iconThemeDark?.classList.toggle('hidden', !dark);
      iconThemeLight?.classList.toggle('hidden', dark);
    };

    const applyTheme = () => {
      toggleTheme();
      paintThemeButton();
    };

    themeButton?.addEventListener('click', () => {
      playClick();
      applyTheme();
    });
    root.__applyTheme = applyTheme;

    paintThemeButton();

    /* -------------------------------------------------------------------- accent */

    const accentButtons = [...root.querySelectorAll<HTMLButtonElement>('[data-accent-value]')];

    const paintAccent = () => {
      const current = getInitialAccent();
      for (const button of accentButtons) {
        const selected = button.dataset.accentValue === current;
        button.setAttribute('aria-pressed', String(selected));
        button.classList.toggle('scale-110', selected);
        button.classList.toggle('ring-2', selected);
        button.classList.toggle('ring-foreground', selected);
        button.classList.toggle('ring-offset-2', selected);
        button.classList.toggle('ring-offset-background', selected);
        button.classList.toggle('ring-1', !selected);
      }
    };

    for (const button of accentButtons) {
      button.addEventListener('click', () => {
        playClick();
        setAccent(button.dataset.accentValue as Accent);
        paintAccent();
      });
    }

    paintAccent();

    /* ----------------------------------------------------------------- font scale */

    const scaleDown = root.querySelector<HTMLButtonElement>('[data-font-scale-down]');
    const scaleUp = root.querySelector<HTMLButtonElement>('[data-font-scale-up]');
    const ORDER: FontScale[] = ['sm', 'md', 'lg'];

    const paintFontScale = () => {
      const i = ORDER.indexOf(getInitialFontScale());
      if (scaleDown) scaleDown.disabled = i <= 0;
      if (scaleUp) scaleUp.disabled = i === ORDER.length - 1;
    };

    scaleDown?.addEventListener('click', () => {
      const i = ORDER.indexOf(getInitialFontScale());
      if (i > 0) {
        setFontScale(ORDER[i - 1]);
        paintFontScale();
      }
    });

    scaleUp?.addEventListener('click', () => {
      const i = ORDER.indexOf(getInitialFontScale());
      if (i < ORDER.length - 1) {
        setFontScale(ORDER[i + 1]);
        paintFontScale();
      }
    });

    paintFontScale();

    /* ---------------------------------------------------------------------- sound */

    const soundButton = root.querySelector<HTMLButtonElement>('[data-sound-toggle]');
    const iconSoundOn = root.querySelector('[data-icon-sound-on]');
    const iconSoundOff = root.querySelector('[data-icon-sound-off]');

    const paintSoundButton = () => {
      const synth = getSound();
      let muted = true;
      if (synth) {
        muted = synth.getIsMuted();
      } else {
        try {
          const saved = localStorage.getItem('au_sound_muted');
          const hasUrlSound = new URLSearchParams(window.location.search).get('sound') === '1';
          muted = saved !== 'false' && !hasUrlSound;
        } catch {
          muted = true;
        }
      }
      const label = muted ? 'Unmute sound effects' : 'Mute sound effects';
      soundButton?.setAttribute('aria-label', label);
      soundButton?.setAttribute('title', label);
      iconSoundOn?.classList.toggle('hidden', muted);
      iconSoundOff?.classList.toggle('hidden', !muted);
    };

    soundButton?.addEventListener('click', () => {
      void ensureSound().then(() => {
        const synth = getSound();
        if (!synth) return;
        if (!synth.toggleMute()) synth.playSuccess();
        paintSoundButton();
      });
    });

    // Delegated so every [data-sound] element works without a per-element listener.
    root.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('[data-sound]')) playClick();
    });

    paintSoundButton();

    /* -------------------------------------------------------------- profile patch */

    // The profile lives in localStorage, so server-rendered defaults are patched on load.
    // Kept in sync with src/context/TeenProfileContext.tsx.
    const paintProfile = () => {
      let profile: { name?: string; age?: number; location?: string } = {};
      try {
        const raw = localStorage.getItem('aus_teen_profile');
        if (raw) profile = JSON.parse(raw);
      } catch {
        profile = {};
      }
      if (profile.name) {
        for (const el of root.querySelectorAll('[data-profile-name]')) el.textContent = profile.name;
      }
      if (typeof profile.age === 'number') {
        for (const el of root.querySelectorAll('[data-profile-age]')) {
          el.textContent = String(profile.age);
        }
      }
      if (profile.location) {
        for (const el of root.querySelectorAll('[data-profile-location]')) {
          el.textContent = profile.location;
        }
      }
    };

    paintProfile();
    root.__paintProfile = paintProfile;

    /* ---------------------------------------------------------- active link state */

    const paintActiveLinks = () => {
      const current = window.location.pathname || '/';
      const calcsActive = CALC_ROUTES.includes(current);
      const modulesActive =
        current !== '/' && current !== '/profile' && !current.startsWith('/calculators');

      const paint = (el: Element | null | undefined, active: boolean) => {
        if (!el) return;
        toggleClasses(el, ACTIVE_INDICATOR, active);
        toggleClasses(el, INACTIVE_INDICATOR, !active);
      };

      paint(dropdowns.get('calcs')?.button, calcsActive);
      paint(dropdowns.get('modules')?.button, modulesActive);

      for (const link of root.querySelectorAll<HTMLAnchorElement>('[data-nav-route]')) {
        const active = current === link.dataset.navRoute;
        paint(link, active);
        if (active) link.setAttribute('aria-current', 'page');
        else link.removeAttribute('aria-current');
      }

      for (const link of root.querySelectorAll<HTMLAnchorElement>('[data-module-route]')) {
        if (current === link.dataset.moduleRoute) link.setAttribute('aria-current', 'page');
        else link.removeAttribute('aria-current');
      }
    };

    paintActiveLinks();

    /* ------------------------------------------------------------------- motion */

    const motionButtons = [...root.querySelectorAll<HTMLButtonElement>('[data-motion-value]')];

    const paintMotion = (current: string) => {
      for (const button of motionButtons) {
        button.setAttribute('aria-checked', String(button.dataset.motionValue === current));
      }
    };

    for (const button of motionButtons) {
      button.addEventListener('click', () => {
        void motion().then((m) => {
          const next = button.dataset.motionValue as m.MotionPreference;
          m.setMotionPreference(next);
          paintMotion(next);
        });
      });
    }

    // Reflect whatever is already in effect (the OS setting counts when the user
    // has never touched the control).
    void motion().then((m) => paintMotion(m.readStoredPreference()));

    /* ---------------------------------------------------------- command palette */

    for (const button of root.querySelectorAll('[data-open-palette]')) {
      button.addEventListener('click', () => {
        void loadOverlay().then((m) => m.openCommandPalette());
      });
    }
  }

  const start = () => {
    const root = liveRoot();
    if (root) init(root);
  };

  start();

  /* Bind the document-level listeners exactly once, no matter how many times this module is
     evaluated across ClientRouter navigations, and always resolve the live header. Without
     the guard they would stack up (one extra set per navigation) and each stale copy would
     test a detached node. */
  const wired = window as unknown as Record<string, boolean | undefined>;
  if (!wired.__ausNavbarWired) {
    wired.__ausNavbarWired = true;

    document.addEventListener('pointerdown', (e) => {
      liveRoot()?.__closeOutside?.(e.target as Node);
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') liveRoot()?.__closeAll?.();
    });

    // Down-arrow on a collapsed disclosure moves focus into the panel, per the APG
    // disclosure-navigation pattern. Arrow keys *within* the panel are deliberately
    // left alone so ordinary tab/shift-tab navigation still behaves normally.
    document.addEventListener('keydown', (e) => {
      if (e.key !== 'ArrowDown' || e.altKey || e.ctrlKey || e.metaKey) return;
      const target = e.target as HTMLElement | null;
      if (!target?.matches?.('[data-dropdown-toggle]')) return;
      e.preventDefault();
      target.click();
      liveRoot()?.__focusFirstItem?.();
    });

    // The React Navbar used to expose this document event for the global shortcut handler.
    document.addEventListener('toggle-theme-request', () => liveRoot()?.__applyTheme?.());

    // The profile can change on /profile while this Navbar persists across navigation.
    document.addEventListener('aus:profile-change', () => liveRoot()?.__paintProfile?.());
    document.addEventListener('storage', () => liveRoot()?.__paintProfile?.());

    // Astro's ClientRouter swaps the document without a reload, so re-wire and repaint.
    document.addEventListener('astro:page-load', start);
  }
</script>
