---
interface Props {
  badge?: string;
  title: string;
  description?: string;
  backHref?: string;
  backLabel?: string;
  moduleNumber?: number;
  class?: string;
}

const {
  badge,
  title,
  description,
  backHref,
  backLabel,
  moduleNumber,
  class: className = '',
} = Astro.props;
---

<header class={`relative mb-8 isolate ${className}`}>
  {/* Decorative ink blots breathing behind the title block */}
  <div
    aria-hidden="true"
    class="pointer-events-none absolute -top-20 -left-12 w-72 h-72 ink-blot ink-blot-sm ink-blot-cyan dark:opacity-50 animate-pulse-soft"
  ></div>
  <div
    aria-hidden="true"
    class="pointer-events-none absolute -top-10 -right-16 w-56 h-56 ink-blot ink-blot-sm ink-blot-violet dark:opacity-40 hidden sm:block"
  ></div>

  {/* Header art: a small, self-contained "future dashboard" vignette. It is
      decorative only, hidden below lg where the title needs the full width. */}
  <div
    aria-hidden="true"
    class="pointer-events-none absolute -top-6 right-0 hidden h-52 w-[21rem] select-none lg:block xl:w-[24rem]"
  >
    <div class="dot-field inset-0 opacity-40"></div>
    <div class="orbit-ring -top-2 right-10 h-40 w-40 opacity-50"></div>
    <div class="orbit-ring orbit-ring-reverse top-8 right-24 h-28 w-28 opacity-30"></div>

    {/* Floating mini balance card */}
    <div class="animate-float-art absolute right-4 top-3 w-56 rotate-[-4deg] rounded-2xl border border-white/40 bg-card/90 p-4 shadow-[0_18px_40px_-16px_oklch(var(--accent-l)_var(--accent-c)_var(--accent-h)/0.55)] backdrop-blur-md dark:border-white/10">
      <div class="flex items-center justify-between">
        <span class="text-[9px] font-bold uppercase tracking-[0.16em] text-muted-foreground">Net worth</span>
        <span class="inline-flex items-center gap-1 rounded-full bg-emerald-500/15 px-1.5 py-0.5 text-[9px] font-bold text-emerald-600 dark:text-emerald-400">▲ 12.4%</span>
      </div>
      <div class="mt-1.5 flex items-end gap-1 font-mono text-xl font-extrabold tracking-tight text-foreground">
        <span class="text-xs text-muted-foreground">$</span>24,860
      </div>
      <svg viewBox="0 0 190 46" class="mt-2 h-11 w-full overflow-visible" fill="none">
        <defs>
          <linearGradient id="ph-area" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0%" stop-color="currentColor" stop-opacity="0.32"></stop>
            <stop offset="100%" stop-color="currentColor" stop-opacity="0"></stop>
          </linearGradient>
          <linearGradient id="ph-line" x1="0" y1="0" x2="1" y2="0">
            <stop offset="0%" stop-color="var(--primary)"></stop>
            <stop offset="60%" stop-color="oklch(0.68 0.17 293)"></stop>
            <stop offset="100%" stop-color="oklch(0.78 0.15 70)"></stop>
          </linearGradient>
        </defs>
        <path d="M2 38 C18 36 24 28 38 30 S62 20 78 24 S104 10 122 14 S154 6 188 3 V46 H2 Z" fill="url(#ph-area)" class="text-primary"></path>
        <path d="M2 38 C18 36 24 28 38 30 S62 20 78 24 S104 10 122 14 S154 6 188 3" stroke="url(#ph-line)" stroke-width="2.5" stroke-linecap="round" class="svg-draw"></path>
        <circle cx="188" cy="3" r="3.5" fill="var(--accent-pop)" class="animate-pulse-soft"></circle>
      </svg>
    </div>

    {/* Coin stack */}
    <div class="animate-float-art-alt absolute bottom-0 left-2 h-16 w-16">
      <div class="absolute bottom-0 left-2 h-10 w-14 rounded-[50%] bg-gradient-to-b from-amber-300 to-amber-500 shadow-[0_8px_10px_-6px_rgba(180,83,9,0.7)]"></div>
      <div class="absolute bottom-2 left-2 h-10 w-14 rounded-[50%] border border-amber-200/80 bg-gradient-to-b from-amber-200 via-amber-300 to-amber-500 shadow-[inset_0_2px_0_rgba(255,255,255,0.65),0_8px_12px_-6px_rgba(180,83,9,0.6)]">
        <span class="absolute inset-x-0 top-1/2 -translate-y-1/2 text-center font-mono text-sm font-black text-amber-800/80">$</span>
      </div>
      <div class="absolute bottom-5 left-4 h-9 w-12 rounded-[50%] border border-amber-200/80 bg-gradient-to-b from-amber-200 to-amber-400 shadow-[inset_0_2px_0_rgba(255,255,255,0.65)]"></div>
    </div>

    {/* Sparkle cluster */}
    <span class="animate-twinkle absolute right-2 top-24 h-2 w-2 rounded-full bg-amber-400 shadow-[0_0_12px_currentColor]"></span>
    <span class="animate-twinkle-delayed absolute right-44 top-1 h-1.5 w-1.5 rounded-full bg-violet-400 shadow-[0_0_10px_currentColor]"></span>
    <span class="animate-twinkle absolute bottom-6 right-24 h-1.5 w-1.5 rounded-full bg-cyan-400 shadow-[0_0_10px_currentColor]"></span>
  </div>

  <div class="relative z-10 stagger-fade lg:pr-[20rem] xl:pr-[23rem]">
    {backHref && (
      <a
        href={backHref}
        data-astro-prefetch="hover"
        class="play-surface sheen lift-card inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full text-xs font-semibold text-muted-foreground hover:text-primary transition-all mb-4 group"
      >
        <span class="grid h-5 w-5 place-items-center rounded-full bg-primary/10 text-primary transition-transform group-hover:-translate-x-0.5">←</span>
        <span>{backLabel || 'Back'}</span>
      </a>
    )}

    <div class="flex flex-wrap items-center gap-2.5 mb-2.5">
      {moduleNumber !== undefined && (
        <span class="relative inline-flex items-center isolate">
          {/* Rotating conic-gradient halo around the module pill */}
          <span class="gradient-border rounded-full absolute inset-0" aria-hidden="true"></span>
          <span class="sticker-badge relative z-10 isolate inline-flex items-center px-2.5 py-0.5 rounded-full text-[11px] font-bold tracking-wider uppercase bg-primary/10 text-primary border border-primary/30 font-mono card-specular">
            Module {moduleNumber}
          </span>
        </span>
      )}
      {badge && (
        <span class="play-surface sticker-badge card-specular inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-[11px] font-semibold text-muted-foreground transition-colors hover:border-primary/40">
          <span class="h-1.5 w-1.5 rounded-full bg-primary/70 animate-pulse-soft" aria-hidden="true"></span>
          {badge}
        </span>
      )}
    </div>

    <h1
      class="text-2xl sm:text-3xl lg:text-4xl font-extrabold tracking-tight leading-tight text-transparent bg-gradient-to-r from-foreground via-foreground to-primary bg-clip-text animate-gradient-pan"
      transition:name={`page-title-${title.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`}
    >
      {title}
    </h1>

    {/* Animated gradient accent bar that draws itself in under the title,
        tipped with a gently twinkling light */}
    <div class="relative mt-2.5 h-2 w-32" aria-hidden="true">
      <div class="absolute inset-x-0 top-1/2 mt-[-1.75px] h-[3.5px] rounded-full bg-muted/60"></div>
      <div
        class="absolute left-0 top-1/2 mt-[-1.75px] h-[3.5px] w-full rounded-full bg-gradient-to-r from-primary via-violet-400 to-amber-400 bar-fill shadow-[0_0_12px_oklch(var(--accent-l)_var(--accent-c)_var(--accent-h)/0.7)]"
      ></div>
      <span class="svg-dot absolute right-0 top-1/2 mt-[-3px] h-1.5 w-1.5 rounded-full bg-amber-400 shadow-[0_0_8px_rgba(251,191,36,1)]"></span>
    </div>

    {description && (
      <p class="mt-3 text-sm sm:text-base text-muted-foreground max-w-3xl leading-relaxed">
        {description}
      </p>
    )}
  </div>
</header>
